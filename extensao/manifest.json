{
  "manifest_version": 3,
  "name": "Captura Tica",
  "version": "2.0.1",
  "description": "Junta links de produtos e despeja no campo de cadastro da vitrine do Tica Promos.",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gestao.tudosobrepromos.com/*",
        "https://gestao.ticapromos.com.br/*"
      ],
      "js": ["painel.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Captura Tica",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
