{
  "manifest_version": 3,
  "name": "Captura Tica",
  "version": "2.6.1",
  "description": "Junta links para a vitrine do Tica Promos, insere os cupons do Mercado Livre na sua conta e lê a validade deles.",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gestao.ticapromos.com.br/*",
        "https://gestao.tudosobrepromos.com/*",
        "https://davileles.github.io/tudo-sobre-promos/*"
      ],
      "js": [
        "painel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Captura Tica",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
